RATE_LIMIT_MODE=off
RATE_LIMIT_KEY_PREFIX=vnibb:rate-limit
RATE_LIMIT_KEY_VERSION=v1
RATE_LIMIT_WINDOW_SECONDS=60
WEBSOCKET_MAX_CONNECTIONS=100
WEBSOCKET_MAX_SYMBOLS_PER_CONNECTION=10
WEBSOCKET_MAX_ACTIVE_SYMBOLS=20
WEBSOCKET_FETCH_CONCURRENCY=4
WEBSOCKET_BROADCAST_CONCURRENCY=20
WEBSOCKET_CYCLE_TIMEOUT_SECONDS=4.5
WEBSOCKET_SEND_TIMEOUT_SECONDS=2
SCHEDULER_ROLE=api
SCHEDULER_LOCK_ENABLED=true
SCHEDULER_LOCK_MODE=best_effort
SCHEDULER_LOCK_KEY_PREFIX=vnibb:scheduler-lock
SCHEDULER_LOCK_TTL_MARGIN_SECONDS=60
